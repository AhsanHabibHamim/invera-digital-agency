# ===== Invera Digital Agency — Backend (Production) =====
NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.ep70kjj.mongodb.net/<db>?retryWrites=true&w=majority

# Auth — REQUIRED in production (>= 32 random chars each)
JWT_SECRET=<openssl rand -base64 48>
JWT_REFRESH_SECRET=<openssl rand -base64 48>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP email verification
OTP_EXPIRES_IN_MINUTES=15
OTP_MAX_ATTEMPTS=5

# URLs / CORS (comma-separated exact origins, no trailing slash)
FRONTEND_URL=https://inveradigitalagency.com
CORS_ORIGINS=https://inveradigitalagency.com,https://www.inveradigitalagency.com

# Branding / Email (Resend — domain must be verified)
BRAND_NAME=Invera Digital Agency
EMAIL_FROM=Invera Digital Agency <noreply@inveradigitalagency.com>
RESEND_API_KEY=re_...

# AI chatbot (Groq recommended; Gemini optional fallback)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=

# Media uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
